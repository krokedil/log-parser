{
    "name": "krokedil/log-parser",
    "type": "project",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Krokedil AB",
            "email": "info@krokedil.se"
        }
    ],
    "autoload": {
        "psr-4": {
            "Krokedil\\LogParser\\": "src/"
        }
    },
    "scripts": {
        "parse": "@php -f index.php parse",
        "cs-check": "@php ./vendor/bin/phpcs --standard=phpcs.xml src/ index.php",
        "cs-fix": "@php ./vendor/bin/phpcbf --standard=phpcs.xml src/ index.php",
        "test": "@php ./vendor/bin/phpunit"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.4.1",
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "ulrichsg/getopt-php": "^4.0",
        "krokedil/wp-api": "dev-develop"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/krokedil/wp-api.git"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Krokedil\\LogParser\\Tests\\": "tests/"
        }
    }
}
